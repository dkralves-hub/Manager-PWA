{
  "rules": {
    ".read": false,
    ".write": false,
    "salas": {
      "$cod": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/host').val() === auth.uid",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)"
        },
        "jogadores": {
          "$uid": { ".write": "auth != null && $uid === auth.uid" }
        },
        "patch": {
          "$uid": { ".write": "auth != null && $uid === auth.uid" }
        },
        "reservas": {
          "$slug": { ".write": "auth != null && (!data.exists() || data.val() === auth.uid)" }
        },
        "ordem": {
          "$slot": { ".write": "auth != null && (!data.exists() || data.val() === auth.uid)" }
        }
      }
    }
  }
}
